# ============================================================================
# BASPAR Intelligent CMMS/EAM — environment template (§42, §51, §70)
# Copy to `.env` and adjust. NEVER commit the real `.env`.
# ============================================================================

# --- Environment: development | staging | production ------------------------
ENVIRONMENT=development

# --- Security ----------------------------------------------------------------
# REQUIRED in production: generate with `openssl rand -hex 32`
SECRET_KEY=change-me-in-production-please-0123456789abcdef

# --- Database ----------------------------------------------------------------
# SQLite (default, zero-config, file based):
DATABASE_URL=sqlite:///./storage/db/cmms.db
# PostgreSQL (recommended for multi-user production):
# DATABASE_URL=postgresql+psycopg://cmms:PASSWORD@localhost:5432/cmms

# --- Initial admin account (created by scripts/seed.py if missing) ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345

# --- File storage --------------------------------------------------------------
STORAGE_ROOT=./storage
MAX_UPLOAD_MB=50

# --- Auth ------------------------------------------------------------------------
ACCESS_TOKEN_TTL_MINUTES=720
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300

# --- Server ------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
